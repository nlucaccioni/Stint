<!--
  Tests for the plugin's connection code. They compile src/Connection directly
  instead of referencing the plugin, because the plugin needs Logitech's
  PluginApi.dll and the connection code doesn't. Run: dotnet test
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\src\Connection\*.cs" Link="Connection\%(Filename)%(Extension)" />
    <Compile Include="..\src\Display\Format.cs" Link="Display\Format.cs" />
    <Compile Include="..\src\Display\TextLayout.cs" Link="Display\TextLayout.cs" />
  </ItemGroup>

  <!-- Test-only packages: Microsoft.NET.Test.Sdk (MIT), xunit (Apache-2.0). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
